{
  "title": "Lesson 5 - Joins Advanced (Student Answer Key)",
  "output_twbx": "student/workbooks/05_joins_advanced_student.twbx",
  "datasource_caption": "battle_participant + pokemon + trainer",
  "tables": [
    {
      "alias": "battle_participant",
      "csv_path": "shared/raw_data/battle_participant.csv",
      "columns": [
        {
          "name": "battle_participant_id",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "battle_id",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "trainer_id",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "team_side",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "pokemonid",
          "datatype": "integer",
          "role": "dimension"
        },
        {
          "name": "is_winner",
          "datatype": "integer",
          "role": "dimension"
        },
        {
          "name": "is_mvp_flag",
          "datatype": "integer",
          "role": "dimension"
        },
        {
          "name": "adjusted_power",
          "datatype": "real",
          "role": "measure"
        }
      ]
    },
    {
      "alias": "pokemon",
      "csv_path": "shared/raw_data/pokemon.csv",
      "columns": [
        {
          "name": "pokedex_number",
          "datatype": "integer",
          "role": "dimension"
        },
        {
          "name": "name",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "type1",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "is_legendary",
          "datatype": "integer",
          "role": "dimension"
        },
        {
          "name": "base_total",
          "datatype": "integer",
          "role": "measure"
        }
      ]
    },
    {
      "alias": "trainer",
      "csv_path": "shared/raw_data/trainer.csv",
      "columns": [
        {
          "name": "trainer_id",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "trainer_name",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "trainer_class",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "home_region",
          "datatype": "string",
          "role": "dimension"
        },
        {
          "name": "experience_tier",
          "datatype": "string",
          "role": "dimension"
        }
      ]
    }
  ],
  "joins": [
    {
      "left_table": "battle_participant",
      "left_col": "pokemonid",
      "right_table": "pokemon",
      "right_col": "pokedex_number",
      "join_type": "left"
    },
    {
      "left_table": "battle_participant",
      "left_col": "trainer_id",
      "right_table": "trainer",
      "right_col": "trainer_id",
      "join_type": "left"
    }
  ],
  "calculated_fields": [
    {
      "caption": "Legendary Label",
      "datatype": "string",
      "role": "dimension",
      "type": "nominal",
      "formula": "IIF([pokemon_is_legendary]=1, \"Legendary\", \"Standard\")"
    }
  ],
  "worksheets": [
    {
      "name": "A - Avg Power by Pokemon Type",
      "mark": "Bar",
      "rows": [
        {
          "field": "adjusted_power",
          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "pokemon_type1",
          "agg": "None"
        }
      ],
      "color": {
        "field": "Legendary Label",
        "agg": "None"
      }
    },
    {
      "name": "B - Win Rate by Trainer Class",
      "mark": "Bar",
      "rows": [
        {
          "field": "is_winner",
          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "trainer_trainer_class",
          "agg": "None"
        }
      ]
    },
    {
      "name": "C - Region x Type Heat Map",
      "mark": "Square",
      "rows": [
        {
          "field": "pokemon_type1",
          "agg": "None"
        }
      ],
      "cols": [
        {
          "field": "trainer_home_region",
          "agg": "None"
        }
      ],
      "color": {
        "field": "battle_participant_id",
        "agg": "Count"
      }
    },
    {
      "name": "BONUS - MVP Rate by Type",
      "mark": "Bar",
      "rows": [
        {
          "field": "is_mvp_flag",
          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "pokemon_type1",
          "agg": "None"
        }
      ]
    }
  ]
}