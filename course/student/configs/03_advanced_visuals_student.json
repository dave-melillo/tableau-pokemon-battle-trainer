{
  "title": "Lesson 3 - Advanced Visuals (Student Answer Key)",
  "data_csv": "shared/raw_data/battles.csv",
  "output_twbx": "student/workbooks/03_advanced_visuals_student.twbx",
  "datasource_caption": "battles",
  "columns": [
    {
      "name": "battle_id",
      "datatype": "string",
      "role": "dimension"
    },
    {
      "name": "battle_date",
      "datatype": "date",
      "role": "dimension"
    },
    {
      "name": "venue_id",
      "datatype": "string",
      "role": "dimension"
    },
    {
      "name": "battle_format",
      "datatype": "string",
      "role": "dimension"
    },
    {
      "name": "winning_side",
      "datatype": "string",
      "role": "dimension"
    },
    {
      "name": "battle_turns",
      "datatype": "integer",
      "role": "measure"
    },
    {
      "name": "winning_margin",
      "datatype": "real",
      "role": "measure"
    },
    {
      "name": "title_match_flag",
      "datatype": "integer",
      "role": "dimension"
    },
    {
      "name": "weather_condition",
      "datatype": "string",
      "role": "dimension"
    },
    {
      "name": "attendance",
      "datatype": "integer",
      "role": "measure"
    }
  ],
  "calculated_fields": [
    {
      "caption": "Title Match Label",
      "datatype": "string",
      "role": "dimension",
      "type": "nominal",
      "formula": "IIF([title_match_flag]=1, \"Title Match\", \"Regular\")"
    }
  ],
  "worksheets": [
    {
      "name": "A - Heat Map Format x Weather",
      "mark": "Square",
      "rows": [
        {
          "field": "battle_format",
          "agg": "None"
        }
      ],
      "cols": [
        {
          "field": "weather_condition",
          "agg": "None"
        }
      ],
      "color": {
        "field": "battle_id",
        "agg": "Count"
      }
    },
    {
      "name": "B - Attendance Trend by Format",
      "mark": "Line",
      "rows": [
        {
          "field": "attendance",
          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "battle_date",
          "agg": "Month"
        }
      ],
      "color": {
        "field": "battle_format",
        "agg": "None"
      }
    },
    {
      "name": "C - Turns vs Margin Scatter",
      "mark": "Circle",
      "rows": [
        {
          "field": "winning_margin",
          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "battle_turns",
          "agg": "None"
        }
      ],
      "size": {
        "field": "attendance",
        "agg": "Avg"
      }
    },
    {
      "name": "D - Title Match Label In Use",
      "mark": "Bar",
      "rows": [
        {
          "field": "attendance",
          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "Title Match Label",
          "agg": "None"
        }
      ]
    }
  ]
}