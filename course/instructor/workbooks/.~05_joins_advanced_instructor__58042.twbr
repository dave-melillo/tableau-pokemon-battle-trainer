            <column caption='Legendary Label' datatype='string' name='[Calculation_46ed49601c32ae2695]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([pokemon_is_legendary]=1, &quot;Legendary&quot;, &quot;Standard&quot;)' />
