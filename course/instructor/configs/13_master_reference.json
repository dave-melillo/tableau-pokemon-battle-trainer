  "joins": [
    {
      "left_table": "battle_participant",
      "left_col": "pokemonid",
      "right_table": "pokemon",
      "right_col": "pokedex_number",
      "join_type": "left"
    },
    {
      "left_table": "battle_participant",
      "left_col": "trainer_id",
      "right_table": "trainer",
      "right_col": "trainer_id",
      "join_type": "left"
    },
    {
      "left_table": "battle_participant",
      "left_col": "battle_id",
      "right_table": "battles",
      "right_col": "battle_id",
      "join_type": "left"
    },
    {
      "left_table": "battles",
      "left_col": "venue_id",
      "right_table": "venue",
      "right_col": "venue_id",
      "join_type": "left"
    }
  ],
  "calculated_fields": [
    {
      "caption": "Legendary Label",
      "datatype": "string",
      "role": "dimension",
      "type": "nominal",
      "formula": "IIF([pokemon_is_legendary]=1, \"Legendary\", \"Standard\")"
    },
    {
      "caption": "Gym Leader Label",
      "datatype": "string",
      "role": "dimension",
      "type": "nominal",
      "formula": "IIF([trainer_is_gym_leader]=1, \"Gym Leader\", \"Regular\")"
    },
    {
      "caption": "Power Tier",
      "datatype": "string",
      "role": "dimension",
      "type": "nominal",
      "formula": "IF [adjusted_power] >= 600 THEN \"S-Tier\"\nELSEIF [adjusted_power] >= 500 THEN \"A-Tier\"\nELSEIF [adjusted_power] >= 400 THEN \"B-Tier\"\nELSE \"C-Tier\"\nEND"
    },
    {
      "caption": "Type Advantage Match",
      "datatype": "string",
      "role": "dimension",
      "type": "nominal",
      "formula": "IIF([pokemon_type1]=[venue_venue_type], \"Aligned\", \"Not Aligned\")"
    },
    {
      "caption": "Power Boost",
      "datatype": "real",
      "role": "measure",
      "type": "quantitative",
      "formula": "[adjusted_power] - [base_power]"
    },
    {
      "caption": "Pokemon Win Rate (FIXED)",
      "datatype": "real",
      "role": "measure",
      "type": "quantitative",
      "formula": "{ FIXED [pokemon_name] : AVG([is_winner]) }"
    },
    {
      "caption": "Pokemon Type Win Rate (FIXED)",
      "datatype": "real",
      "role": "measure",
      "type": "quantitative",
      "formula": "{ FIXED [pokemon_type1] : AVG([is_winner]) }"
    },
    {
      "caption": "Trainer Win Rate (FIXED)",
      "datatype": "real",
      "role": "measure",
      "type": "quantitative",
      "formula": "{ FIXED [trainer_id] : AVG([is_winner]) }"
    },
    {
      "caption": "Type x Venue Win Rate",
      "datatype": "real",
      "role": "measure",
      "type": "quantitative",
      "formula": "{ FIXED [pokemon_type1], [venue_venue_type] : AVG([is_winner]) }"
    },
    {
      "caption": "Trainer x Type Win Rate",
      "datatype": "real",
      "role": "measure",
      "type": "quantitative",
      "formula": "{ FIXED [trainer_id], [pokemon_type1] : AVG([is_winner]) }"
    },
    {
      "caption": "Venue Battles (FIXED)",
      "datatype": "integer",
      "role": "measure",
      "type": "quantitative",
      "formula": "{ FIXED [battles_venue_id] : COUNTD([battle_id]) }"
    },
    {
      "caption": "MVP Win Rate",
      "datatype": "real",
      "role": "measure",
      "type": "quantitative",
      "formula": "{ FIXED [pokemon_name] : AVG([is_mvp_flag]) }"
    }
  ],
