          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "pokemon_type1",
          "agg": "None"
        }
      ]
    },
    {
      "name": "05 Type x Venue Win Rate (L07)",
      "mark": "Square",
      "rows": [
        {
          "field": "pokemon_type1",
          "agg": "None"
        }
      ],
      "cols": [
        {
          "field": "venue_venue_type",
          "agg": "None"
        }
      ],
      "color": {
        "field": "L07 FIXED VType - Type Win Rate",
        "agg": "Avg"
      }
    },
    {
      "name": "06 % of Total Power (L13)",
      "mark": "Bar",
      "rows": [
        {
          "field": "L13 % of Total via FIXED",
          "agg": "None"
        }
      ],
      "cols": [
        {
          "field": "team_side",
          "agg": "None"
        }
      ]
    },
    {
      "name": "07 Battles per Venue (L05)",
      "mark": "Bar",
      "rows": [
        {
          "field": "L05 FIXED Venue - Battles",
          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "battles_venue_id",
          "agg": "None"
        }
      ]
    },
    {
      "name": "08 Battles per Trainer (L14)",
      "mark": "Bar",
      "rows": [
        {
          "field": "L14 Trainer Battle Count (FIXED)",
          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "trainer_experience_tier",
          "agg": "None"
        }
      ]
    }
  ]
}