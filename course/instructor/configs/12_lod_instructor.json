          "field": "L03 FIXED Trainer - Win Rate",
          "agg": "None"
        }
      ]
    },
    {
      "name": "02 Trainer vs Overall (L11)",
      "mark": "Bar",
      "rows": [
        {
          "field": "L11 Comparison - Trainer vs Overall",
          "agg": "Avg"
        }
      ],
      "cols": [
        {
          "field": "trainer_experience_tier",
          "agg": "None"
        }
      ]
    },
    {
      "name": "03 Power vs Trainer Avg (L10)",
      "mark": "Bar",
      "rows": [
        {
